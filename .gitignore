# API keys — never commit these
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Hugging Face model cache — big, and rebuildable
.cache/
models/

# The notebook's training output directory. Checkpoints are hundreds of MB and
# they are not evidence of anything — results.json is. Without this line a
# `git add -A` in Colab commits a model checkpoint to your repo.
takemeter_out/

# OS noise
.DS_Store
Thumbs.db

# NOTE: results.json, results_three_seeds.json and baseline_results.json are
# deliberately NOT ignored. They're evidence the run actually happened, and
# they're part of what gets graded. Commit them.

# The saved TakeMeter model (capstone). ~270 MB and rebuildable from the
# notebook: sections 1-5 plus the save cell.
takemeter_model/

# The ONNX export (capstone hosting). Only the 268 MB weights file is ignored:
# it ships as a GitHub Release asset. The tokenizer, config and checksum next
# to it ARE committed, because the server needs them.
takemeter_onnx/model.onnx
takemeter_onnx/model.part

# Local server log. The hosted run record is pasted into README.md instead.
logs/server_log.jsonl
